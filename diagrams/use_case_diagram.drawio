<mxfile host="app.diagrams.net" version="21.0.0"><diagram id="page_usecase" name="Figure 4.5 Use Case Diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="FIGURE 4.5: UML USE CASE DIAGRAM FOR ISL MULTILINGUAL TRANSLATION SYSTEM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="3" value="ISL to Multilingual Translation System Boundary" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="600" height="750" as="geometry" /></mxCell><mxCell id="4" value="Signer&lt;br&gt;(Deaf/Mute User)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="60" height="100" as="geometry" /></mxCell><mxCell id="5" value="Recipient&lt;br&gt;(Hearing Audience)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1050" y="260" width="60" height="100" as="geometry" /></mxCell><mxCell id="6" value="System Admin /&lt;br&gt;Developer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Times New Roman;font