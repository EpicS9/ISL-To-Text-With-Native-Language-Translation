<mxfile host="app.diagrams.net" version="21.0.0"><diagram id="page_arch" name="Figure 4.1 Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="960" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="FIGURE 4.1: SYSTEM ARCHITECTURE OF ISL TO MULTILINGUAL TRANSLATION SYSTEM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="950" height="30" as="geometry" /></mxCell><mxCell id="3" value="PRESENTATION &amp; FRONTEND CLIENT (WEB APP / UI)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="1160" height="100" as="geometry" /></mxCell><mxCell id="4" value="WEBCAM INPUT&lt;br&gt;(1280x720 @ 30 FPS)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="105" width="180" height="50" as="geometry" /></mxCell><mxCell id="5" value="CLIENT UI&lt;br&gt;(Video Canvas &amp; HUD)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="310" y="105" width="180" height="50" as="geometry" /></mxCell><mxCell id="6" value="MODE SELECTOR&lt;br&gt;(Static / Dynamic Toggle)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="540" y="105" width="190" height="50" as="geometry" /></mxCell><mxCell id="7" value="LANGUAGE SELECTOR&lt;br&gt;(Hindi, Tamil, Telugu, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="780" y="105" width="200" height="50" as="geometry" /></mxCell><mxCell id="8" value="OUTPUT BANNER &amp;&lt;br&gt;TTS AUDIO PLAYER" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1020" y="105" width="160" height="50" as="geometry" /></mxCell><mxCell id="9" value="VISION &amp; LANDMARK EXTRACTION PIPELINE" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="1160" height="110" as="geometry" /></mxCell><mxCell id="10" value="MEDIAPIPE HOLISTIC&lt;br&gt;&lt;b&gt;Landmark Extraction&lt;/b&gt;&lt;br&gt;• Pose (33)&lt;br&gt;• Hands (21+21)&lt;br&gt;• Face (92)&lt;br&gt;Total: 534 Features" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="260" height="70" as="geometry" /></mxCell><mxCell id="11" value="SHOULDER-RELATIVE NORMALIZATION&lt;br&gt;• Center to mid-shoulder origin&lt;br&gt;• Scale by Euclidean shoulder span&lt;br&gt;• Aspect ratio invariance" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="320" height="70" as="geometry" /></mxCell><mxCell id="12" value="TEMPORAL SLIDING BUFFER&lt;br&gt;30-Frame FIFO Queue&lt;br&gt;Shape: (30, 534) Matrix" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="220" height="70" as="geometry" /></mxCell><mxCell id="13" value="MODE ROUTER&lt;br&gt;Active Branch Switch" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="140" height="70" as="geometry" /></mxCell><mxCell id="14" value="534 Coords" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="Normalized Vectors" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="Buffer Data" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="DUAL-BRANCH DEEP LEARNING INFERENCE CORE (V3 COMPILED ENGINE)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="1160" height="150" as="geometry" /></mxCell><mxCell id="18" value="STATIC SIGN RECOGNITION BRANCH&lt;br&gt;&lt;b&gt;Residual Dense MLP (35 Classes)&lt;/b&gt;&lt;br&gt;• 1D Input Vector (534)&lt;br&gt;• Dense (512, 256, 128, 64) + Residual Skips&lt;br&gt;• BatchNorm, ReLU, Dropout (0.3)&lt;br&gt;• Latency: ~2ms via @tf.function" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="360" height="95" as="geometry" /></mxCell><mxCell id="19" value="DYNAMIC SIGN RECOGNITION BRANCH&lt;br&gt;&lt;b&gt;Conv1D + BiLSTM + Bahdanau Attention (11 Classes)&lt;/b&gt;&lt;br&gt;• Temporal Input (30, 534)&lt;br&gt;• Conv1D (64, 128) -&gt; BiLSTM (128, 64)&lt;br&gt;• Bahdanau Attention Context Pooling&lt;br&gt;• Latency: ~3ms via @tf.function" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="390" height="95" as="geometry" /></mxCell><mxCell id="20" value="POST-PROCESSING GATE&lt;br&gt;• Softmax Threshold (&gt;85%)&lt;br&gt;• Debounce Consensus Filter&lt;br&gt;• Cooldown &amp; Commit Lock" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="360" width="230" height="95" as="geometry" /></mxCell><mxCell id="21" value="Static Mode" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="13" target="18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="22" value="Dynamic Mode" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="13" target="19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" value="Class Prob." style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="18" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="Class Prob." style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="19" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" value="NATURAL LANGUAGE PROCESSING (NLP) &amp; SENTENCE STRUCTURING ENGINE" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="1160" height="120" as="geometry" /></mxCell><mxCell id="26" value="RAW GLOSS ACCUMULATOR&lt;br&gt;Collects committed sign tokens&lt;br&gt;[ 'HELLO', 'NAME', 'YOU', ... ]" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="240" height="65" as="geometry" /></mxCell><mxCell id="27" value="SPELL CHECK &amp; COMPOUNDING&lt;br&gt;Merges fingerspelled letters&lt;br&gt;(e.g., 'R'+'O'+'O'+'P' -&gt; 'ROOP')" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="530" width="240" height="65" as="geometry" /></mxCell><mxCell id="28" value="GLOSS-TO-SENTENCE SYNTHESIZER&lt;br&gt;• ISL SOV to English SVO Grammar Restructuring&lt;br&gt;• Auxiliary Verb &amp; Article Insertion&lt;br&gt;• Synthesizes Fluent Natural English" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="530" width="330" height="65" as="geometry" /></mxCell><mxCell id="29" value="SYNTHESIZED ENGLISH&lt;br&gt;&quot;Hello, what is your name?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="530" width="140" height="65" as="geometry" /></mxCell><mxCell id="30" value="Stable Gloss" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="20" target="26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="31" value="Token Stream" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="26" target="27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="32" value="Clean Glosses" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="27" target="28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="33" value="Grammar Fixed" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="28" target="29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="34" value="MULTILINGUAL TRANSLATION &amp; LOCALIZATION ENGINE (GOOGLE TRANSLATE API)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="630" width="1160" height="120" as="geometry" /></mxCell><mxCell id="35" value="SECURE API GATEWAY&lt;br&gt;Google Cloud Translation API Client&lt;br&gt;API Key / OAuth2 Verification" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="670" width="280" height="65" as="geometry" /></mxCell><mxCell id="36" value="GOOGLE CLOUD TRANSLATION API&lt;br&gt;Neural Machine Translation (NMT)&lt;br&gt;Language Target Code (hi, ta, te, kn, mr, bn)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fillColor=#F8F9FA;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="670" width="330" height="65" as="geometry" /></mxCell><mxCell id="37" value="RESPONSE PARSER &amp;&lt;br&gt;LOCALIZATION BUFFER&lt;br&gt;Caches output in selected language" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="670" width="230" height="65" as="geometry" /></mxCell><mxCell id="38" value="English Text" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="29" target="35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="39" value="REST HTTPS Request" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="35" target="36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="40" value="NMT Response JSON" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="36" target="37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="41" value="OUTPUT PRESENTATION &amp; AUDIO SYNTHESIS" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=13;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;fillColor=#FDFDFD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="1160" height="90" as="geometry" /></mxCell><mxCell id="42" value="MULTILINGUAL TEXT DISPLAY&lt;br&gt;Real-time Subtitle / Banner Overlay" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="805" width="340" height="45" as="geometry" /></mxCell><mxCell id="43" value="TEXT-TO-SPEECH (TTS) SYNTHESIZER&lt;br&gt;Native Regional Audio Output" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontStyle=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;align=center;arcSize=15;" vertex="1" parent="1"><mxGeometry x="650" y="805" width="340" height="45" as="geometry" /></mxCell><mxCell id="44" value="Native Text" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="37" target="42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="45" value="TTS Dispatch" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Times New Roman;rounded=0;" edge="1" parent="1" source="37" target="43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="46" value="Figure 4.1: Comprehensive System Architecture with V3 Dual-Models, NLP Synthesizer, and Google Cloud Translation API" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="200" y="890" width="850" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>